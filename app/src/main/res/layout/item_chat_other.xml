<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvDateOther"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textColor="@color/hour_date_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="9 of December" />

    <ImageView
        android:id="@+id/ivUser"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="6dp"
        android:contentDescription="@string/ivUser_accessibility"
        app:layout_constraintBottom_toTopOf="@id/cardChatOther"
        app:layout_constraintStart_toStartOf="parent"
        tools:background="@color/hour_date_color" />

    <TextView
        android:id="@+id/tvNameOther"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@id/cardChatOther"
        app:layout_constraintStart_toEndOf="@id/ivUser"
        tools:text="Fer" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardChatOther"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:cardBackgroundColor="@color/card_me_background"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDateOther">

        <TextView
            android:id="@+id/tvChatOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/message_me_color"
            tools:text="Este es mi mensaje" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/cardChatOther"
        app:layout_constraintStart_toEndOf="@id/cardChatOther"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/ivIsAdminOther"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/accessibility_isAdmin_starIcon"
            android:padding="2dp"
            android:src="@drawable/baseline_star_border_24"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHourOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/hour_date_color"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/cardChat"
            app:layout_constraintEnd_toStartOf="@id/cardChat"
            tools:text="12:45" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>